{
  "name": "compressor-tool",
  "productName": "Aerowis Compressor",
  "version": "0.2.0",
  "description": "Compress, convert and transform images, PDFs and Office documents — entirely on your computer.",
  "main": "./out/main/index.js",
  "author": "faisssss",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "postinstall": "electron-builder install-app-deps",
    "smoke": "tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "@jspawn/ghostscript-wasm": "^0.0.2",
    "@neslinesli93/qpdf-wasm": "^0.3.0",
    "heic-convert": "^2.1.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "framer-motion": "^13.4.4",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
